# Copy this file to .env.local for local development.
# In Vercel, set these as Environment Variables in the dashboard.

# URL of the deployed Flask backend (Railway/Render URL)
# Leave empty to use localhost:5000 in dev
BACKEND_URL=https://your-flask-app.railway.app

# Supabase public keys (safe to expose to browser).
# Required for: Google OAuth flow (/login "Continue with Google") and the
# password-reset landing page. RLS on every table keeps the anon key safe
# even when it is served to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# To enable Google sign-in end-to-end:
#   1. Supabase dashboard -> Authentication -> Providers -> Google -> enable
#   2. Paste your Google OAuth client_id + secret from Google Cloud Console
#   3. Set the redirect URL in Google Cloud to:
#         https://<project-ref>.supabase.co/auth/v1/callback
#   4. Add https://your-vercel-domain.vercel.app/auth/callback to Supabase's
#      "Redirect URLs" allowlist so the returning session lands cleanly.
