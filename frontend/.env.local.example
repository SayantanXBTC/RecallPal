# Copy this file to .env.local for local development.
# In Vercel, set these as Environment Variables in the dashboard.

# URL of the deployed Flask backend (Railway/Render URL)
# Leave empty to use localhost:5000 in dev
BACKEND_URL=https://your-flask-app.railway.app

# Supabase public keys (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
