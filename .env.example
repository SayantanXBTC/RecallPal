# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=generate-a-random-64-char-hex-string
# Production: leave FLASK_ENV unset. Dev only: FLASK_ENV=development
# FLASK_ENV=development

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. No trailing slash.
# Prod example: ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Rate limiting ──────────────────────────────────────────────────────────
# In prod, point to Redis for multi-instance limit consistency.
# RATELIMIT_STORAGE_URI=redis://default:password@host:6379/0

# ── Inference microservice (optional split GPU deployment) ─────────────────
# When set, the web pod delegates insightface calls over HTTP to a GPU pod.
# Leave unset for single-node deploys — inference runs in-process.
# INFERENCE_URL=http://inference:8001
# INFERENCE_SHARED_TOKEN=generate-a-64-char-random-hex-string
# INFERENCE_TIMEOUT_S=2.0

# ── Async enrolment queue (optional Redis + RQ worker) ─────────────────────
# When set together with the inference URL, /api/add-person?async=true
# dispatches enrolment to an RQ worker on the GPU pod and returns 202.
# REDIS_URL=redis://default:password@host:6379/0
# ENROL_JOB_TIMEOUT_S=300

# ── Consent + liveness (GDPR / biometric) ──────────────────────────────────
# Bump when the consent text shown to users changes materially.
# CONSENT_TEXT_VERSION=v1.0
# LIVENESS_MIN_BLUR_VAR=45.0
# LIVENESS_MIN_YAW_STD=5.0
# LIVENESS_MAX_PAIR_SIM=0.995
# LIVENESS_MIN_FRAMES=3

# ── Observability (Sentry + structlog + Prometheus) ────────────────────────
# All optional. Missing SENTRY_DSN just disables error reporting.
# SENTRY_DSN=https://public@sentry.io/1234567
# SENTRY_ENV=production
# SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_PROFILES_SAMPLE_RATE=0.0
# SENTRY_RELEASE=       # or set GIT_SHA at build time
# LOG_LEVEL=INFO
# ENABLE_METRICS=true   # /metrics endpoint served for Prometheus scraping

# ── Dev only (skip auth locally, ONLY when FLASK_ENV=development) ──────────
# DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
