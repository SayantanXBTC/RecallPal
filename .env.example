# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=generate-a-random-64-char-hex-string
# Production: leave FLASK_ENV unset. Dev only: FLASK_ENV=development
# FLASK_ENV=development

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. No trailing slash.
# Prod example: ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Rate limiting ──────────────────────────────────────────────────────────
# In prod, point to Redis for multi-instance limit consistency.
# RATELIMIT_STORAGE_URI=redis://default:password@host:6379/0

# ── Dev only (skip auth locally, ONLY when FLASK_ENV=development) ──────────
# DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
