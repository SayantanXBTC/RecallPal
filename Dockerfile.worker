FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libsm6 libxext6 libxrender-dev libgomp1 libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Warm the insightface weights so enrol jobs don't pay download cost.
RUN python -c "from insightface.app import FaceAnalysis; FaceAnalysis(name='buffalo_l').prepare(ctx_id=-1)"

# RQ worker consumes jobs from the "enrol" queue. Redis URL supplied
# via REDIS_URL env var. Scale replicas horizontally for throughput.
CMD ["rq", "worker", "--url", "$REDIS_URL", "enrol"]
